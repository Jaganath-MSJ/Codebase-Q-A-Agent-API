# Copy to api/.env and fill in. NEVER commit the real .env.

# ---- Database ----
# Neon pooled connection string — the host contains "-pooler".
# Run once in the Neon SQL editor before first use:
#   CREATE EXTENSION IF NOT EXISTS vector;
#   CREATE EXTENSION IF NOT EXISTS pg_trgm;
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# The integration-test database. NOT a Neon branch — assertSafeTestDatabase
# (test/db/db-harness.ts) refuses anything that is not all three of:
#   - a LOCAL host: localhost, 127.0.0.1, ::1 or [::1]
#   - a database name ending in "_test"
#   - a different host+database from DATABASE_URL
# L3 truncates every table between tests, which is what those rules guard.
# Needs the same two extensions as the main database (vector, pg_trgm).
# Leave it EMPTY to run without a database: the L3 layer then skips honestly.
# If you see "client password must be a string", check what owns port 5432
# before touching this value — see DEF-031.
DATABASE_URL_TEST=postgresql://user@127.0.0.1:5432/codebase_qa_agent_test

# ---- Providers ----
# aistudio.google.com — free, no card
GOOGLE_API_KEY=

# console.groq.com — free, no card. Needed for chat.
GROQ_API_KEY=

# local | gemini      Local runs Transformers.js: no key, no quota, works offline.
EMBEDDING_PROVIDER=local
# gemini | groq
CHAT_PROVIDER=gemini

# ---- Storage ----
# Holds cloned repos, ONNX model weights (~100 MB), and the response caches.
# Gitignored. Will reach hundreds of megabytes.
DATA_DIR=./data

# on | off — caches LLM responses to disk keyed on the full prompt hash.
# Leave on while developing; it is the difference between iterating freely
# on the UI and burning a daily quota re-asking the same question.
LLM_CACHE=on

# ---- Server ----
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Comma-separated. Empty in development, where the Vite proxy makes it unnecessary.
CORS_ORIGINS=

# ---- Credentials ----
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts stored GitHub tokens. Losing it means re-entering every token.
CREDENTIAL_KEY=
